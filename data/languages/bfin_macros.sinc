# Status-flag helpers. AC0_COPY and V_COPY are separate ASTAT bits that every
# arithmetic update of AC0 and V writes as well.

macro setnz(r) {
  AZ = r == 0;
  AN = r s< 0;
}

macro setv(o) {
  V = o;
  V_COPY = o;
  VS = VS | o;
}

macro setac0(c) {
  AC0 = c;
  AC0_COPY = c;
}

# Logical results: AZ/AN from the value, AC0 and V cleared.
macro setlogical(r) {
  AZ = r == 0;
  AN = r s< 0;
  AC0 = 0;
  AC0_COPY = 0;
  V = 0;
  V_COPY = 0;
}

macro packastat(t) {
  t = ASTAT_RSV & 0xfcf0ce90;
  t = t | zext(AZ) | (zext(AN) << 1) | (zext(AC0_COPY) << 2) | (zext(V_COPY) << 3);
  t = t | (zext(CC) << 5) | (zext(AQ) << 6) | (zext(RND_MOD) << 8);
  t = t | (zext(AC0) << 12) | (zext(AC1) << 13);
  t = t | (zext(AV0) << 16) | (zext(AV0S) << 17) | (zext(AV1) << 18) | (zext(AV1S) << 19);
  t = t | (zext(V) << 24) | (zext(VS) << 25);
}

macro unpackastat(t) {
  AZ = (t & 0x1) != 0;
  AN = (t & 0x2) != 0;
  AC0_COPY = (t & 0x4) != 0;
  V_COPY = (t & 0x8) != 0;
  CC = (t & 0x20) != 0;
  AQ = (t & 0x40) != 0;
  RND_MOD = (t & 0x100) != 0;
  AC0 = (t & 0x1000) != 0;
  AC1 = (t & 0x2000) != 0;
  AV0 = (t & 0x10000) != 0;
  AV0S = (t & 0x20000) != 0;
  AV1 = (t & 0x40000) != 0;
  AV1S = (t & 0x80000) != 0;
  V = (t & 0x1000000) != 0;
  VS = (t & 0x2000000) != 0;
  ASTAT_RSV = t & 0xfcf0ce90;
}

# Bit reverse of a 32-bit value, for the (BREV) bit-reversed address adds.
macro brev32(x) {
  x = ((x >> 1) & 0x55555555) | ((x & 0x55555555) << 1);
  x = ((x >> 2) & 0x33333333) | ((x & 0x33333333) << 2);
  x = ((x >> 4) & 0x0f0f0f0f) | ((x & 0x0f0f0f0f) << 4);
  x = ((x >> 8) & 0x00ff00ff) | ((x & 0x00ff00ff) << 8);
  x = (x >> 16) | (x << 16);
}

# DAG post-modify. For a configured circular buffer, the index is relative to
# Bn and wraps once at either end of its Ln-byte span. The architectural setup
# requires the original index to lie in the span and |modify| <= length.
# A zero length selects linear addressing, including when Bn retains a value.
macro dagupdate(i, source, b, l, modify) {
  local step:4 = modify;
  local next:4 = source + step;
  if (l == 0) goto <done>;
  local offset:8 = zext(source) - zext(b) + sext(step);
  if (step s< 0) goto <negative>;
  if (offset < zext(l)) goto <wrapped>;
  offset = offset - zext(l);
  goto <wrapped>;
<negative>
  if (offset s>= 0) goto <wrapped>;
  offset = offset + zext(l);
<wrapped>
  next = b + offset:4;
<done>
  i = next;
}

macro dagsub(i, source, b, l, modify) {
  local negative:4 = 0 - modify;
  dagupdate(i, source, b, l, negative);
}

# ---- byte-video helpers (Ghidra-Rare; semantics of gdb sim/bfin/bfin-sim.c) ---------------
# The four bytes a byte-video operation reads from a register pair: the pair is H:L
# (PAIRA/PAIRB export (H << 32) | L); with (R) the halves swap; the low two bits of the
# alignment I register pick the starting byte (sim algn()).
macro bytealign(out, pair, rev, ireg) {
  local c:8 = pair;
  local swapped:8 = (c << 32) | (c >> 32);
  c = zext(rev == 0:1) * c + zext(rev != 0:1) * swapped;
  local sh:8 = zext(ireg & 3) * 8;
  c = c >> sh;
  out = c:4;
}
macro byteat(out, w, n) {
  out = (w >> (n * 8)) & 0xff;
}
macro satu16(out, v) {
  out = v;
  if (v <= 0xffff) goto <ok>;
  out = 0xffff;
<ok>
}
macro clampu8(out, v) {
  out = v;
  if (v s>= 0) goto <notneg>;
  out = 0;
<notneg>
  if (out s<= 255) goto <ok>;
  out = 255;
<ok>
}
# BYTEOP1P: average of byte pairs, rounded up unless (T)
macro byteop1p(dst, pa, pb, rev, rnd) {
  local s0:4; local s1:4;
  bytealign(s0, pa, rev, I0); bytealign(s1, pb, rev, I1);
  local b0:4; local b1:4; local r:4 = 0;
  byteat(b0, s0, 0); byteat(b1, s1, 0); r = r | (((b0 + b1 + rnd) >> 1) & 0xff);
  byteat(b0, s0, 1); byteat(b1, s1, 1); r = r | ((((b0 + b1 + rnd) >> 1) & 0xff) << 8);
  byteat(b0, s0, 2); byteat(b1, s1, 2); r = r | ((((b0 + b1 + rnd) >> 1) & 0xff) << 16);
  byteat(b0, s0, 3); byteat(b1, s1, 3); r = r | ((((b0 + b1 + rnd) >> 1) & 0xff) << 24);
  dst = r;
}

<?xml version="1.0" encoding="UTF-8"?>
<!-- GNU Blackfin ABI (gcc/config/bfin): the first three argument words in R0-R2, further
     ones on the stack above the 12 bytes the caller reserves for R0-R2 ([SP + 12] at entry);
     results in R0 (R1:R0 for 64-bit); RETS holds the return address. -->
<compiler_spec>
  <global><range space="ram"/></global>
  <stackpointer register="SP" space="ram" growth="negative"/>
  <returnaddress>
    <register name="RETS"/>
  </returnaddress>
  <default_proto>
    <prototype name="__bfin_gnu" extrapop="0" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="4" extension="inttype"><register name="R0"/></pentry>
        <pentry minsize="1" maxsize="4" extension="inttype"><register name="R1"/></pentry>
        <pentry minsize="1" maxsize="4" extension="inttype"><register name="R2"/></pentry>
        <pentry minsize="1" maxsize="500" align="4">
          <addr offset="12" space="stack"/>
        </pentry>
        <!-- A 64-bit argument takes the next two words, least significant first. -->
        <rule>
          <datatype name="any"/>
          <join/>
        </rule>
      </input>
      <output killedbycall="true">
        <pentry minsize="1" maxsize="4" extension="inttype"><register name="R0"/></pentry>
        <pentry minsize="5" maxsize="8"><addr space="join" piece1="R1" piece2="R0"/></pentry>
      </output>
      <unaffected>
        <register name="SP"/><register name="FP"/>
        <register name="R4"/><register name="R5"/><register name="R6"/><register name="R7"/>
        <register name="P3"/><register name="P4"/><register name="P5"/>
      </unaffected>
    </prototype>
  </default_proto>
</compiler_spec>
